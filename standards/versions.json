[
  {
    "version": "1",
    "standardId": "obc-v1",
    "status": "active",
    "introduced": "2025",
    "description": "Initial OBC standard. On-chain Solana memo with SHA-256 hash and one or more file-storage URLs. Off-chain JSON contains the full journal with optional per-field anonymization.",
    "onChainSchemaUrl": "standards/v1/onchain-schema.json",
    "offChainSchemaUrl": "standards/v1/offchain-schema.json",
    "readmeUrl": "standards/v1/README.md",
    "onChainFields": ["v", "h", "a"],
    "optionalOnChainFields": ["a1", "a2", "<tenant-configured-journal-fields>"],
    "hashAlgorithm": "SHA-256",
    "blockchains": {
      "production": ["solana"],
      "planned": ["ethereum"]
    },
    "fileStorages": {
      "production": ["azure", "azureblob"],
      "preview": ["ipfs"]
    },
    "anonymizableLineItemFields": [
      "accountName", "accountCode", "customerName",
      "taxName", "taxAuthorityName",
      "acquisitionVatName", "reverseChargeVatName",
      "projectName"
    ],
    "fileNamingPattern": "file-{documentJournalId}.json"
  },
  {
    "version": "2",
    "standardId": "obc-v2",
    "status": "active",
    "introduced": "2026",
    "description": "Version 2 adds multi-dimensional accounting support with up to 10 account codes per line item. Supports complex organizational structures like fund accounting, cost centers, departments, projects, and grants.",
    "onChainSchemaUrl": "standards/v2/onchain-schema.json",
    "offChainSchemaUrl": "standards/v2/offchain-schema.json",
    "readmeUrl": "standards/v2/README.md",
    "onChainFields": ["v", "h", "a"],
    "optionalOnChainFields": ["a1", "a2", "<tenant-configured-journal-fields>"],
    "hashAlgorithm": "SHA-256",
    "blockchains": {
      "production": ["solana"],
      "planned": ["ethereum"]
    },
    "fileStorages": {
      "production": ["azure", "azureblob"],
      "preview": ["ipfs"]
    },
    "anonymizableLineItemFields": [
      "customerName",
      "taxName", "taxAuthorityName",
      "acquisitionVatName", "reverseChargeVatName",
      "projectName",
      "accountCode1", "accountCodeName1",
      "accountCode2", "accountCodeName2",
      "accountCode3", "accountCodeName3",
      "accountCode4", "accountCodeName4",
      "accountCode5", "accountCodeName5",
      "accountCode6", "accountCodeName6",
      "accountCode7", "accountCodeName7",
      "accountCode8", "accountCodeName8",
      "accountCode9", "accountCodeName9",
      "accountCode10", "accountCodeName10"
    ],
    "fileNamingPattern": "file-{documentJournalId}.json",
    "newFeatures": [
      "Multi-dimensional accounting with 10 account code slots",
      "Support for fund accounting (non-profits)",
      "Support for cost center tracking",
      "Support for department/division tracking",
      "Support for project/grant tracking",
      "Enhanced anonymization for all 10 dimensions"
    ],
    "backwardCompatible": true,
    "migrationType": "additive"
  },
  {
    "version": "3",
    "standardId": "obc-v3",
    "status": "active",
    "introduced": "2026",
    "description": "Version 3 separates what from where: files are named by their hash and storage bases are published in an on-chain location account derived from the publisher wallet. The off-chain document is a type-aware envelope, and every version of a document is linked on-chain through d/n/p, including tombstones for voided documents.",
    "onChainSchemaUrl": "standards/v3/onchain-schema.json",
    "offChainSchemaUrl": "standards/v3/envelope-schema.json",
    "locationSchemaUrl": "standards/v3/location-schema.json",
    "typesUrl": "standards/v3/types.json",
    "readmeUrl": "standards/v3/README.md",
    "onChainFields": ["v", "h", "d", "n"],
    "optionalOnChainFields": ["p", "a", "<tenant-configured-journal-fields>"],
    "hashAlgorithm": "SHA-256",
    "blockchains": {
      "production": ["solana"],
      "planned": ["ethereum"]
    },
    "fileStorages": {
      "production": ["azure", "azureblob"],
      "preview": ["ipfs"]
    },
    "locationAccount": {
      "program": "recr1L3PCGKLbckBqMNcJhuuyU1zgo8nBhfLVsJNwr5",
      "seed": "obc-meta",
      "headerSize": 33,
      "maxJsonBytes": 900
    },
    "memoPrograms": {
      "publish": "Memo4c2pN8afCj432Lb7RMVKi9PbQnnW7ewFFaV3oAH",
      "accepted": ["Memo4c2pN8afCj432Lb7RMVKi9PbQnnW7ewFFaV3oAH", "MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr"]
    },
    "maxMemoBytes": 950,
    "documentLookupKey": "sha256(utf8(\"obc-doc\") || P || utf8(d))",
    "documentTypes": ["obc.journal/2", "obc.acc-period-close/1"],
    "fileNamingPattern": "{h}.json",
    "newFeatures": [
      "Storage bases in an on-chain location account (one transaction per storage move)",
      "Hash-based file names",
      "Type-aware off-chain envelope (type, schema, links, data)",
      "On-chain version chain per document (d, n, p) with tombstones",
      "Per-document lookup key k for listing versions",
      "p-memo program for record memos",
      "Signer reporting"
    ],
    "backwardCompatible": true,
    "migrationType": "breaking"
  }
]

