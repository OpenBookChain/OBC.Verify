{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obc.dev/standards/v3/types/journal/2/schema.json",
  "title": "OBC journal content, schema obc.journal/2",
  "description": "Schema for the data member of a v3 envelope with type \"journal\" and schema \"obc.journal/2\". It is the v2 off-chain journal document without its top-level version, with property names as OBC serializes them (PascalCase).",
  "type": "object",
  "required": [
    "JournalDate",
    "LineItems",
    "Taxes",
    "CustomFields"
  ],
  "properties": {
    "EntryNumber": {
      "type": [
        "string",
        "null"
      ],
      "description": "Journal entry number."
    },
    "DocumentReference": {
      "type": [
        "string",
        "null"
      ],
      "description": "External document reference (e.g., invoice number)."
    },
    "DocumentJournalId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Unique journal ID from the source system."
    },
    "JournalDate": {
      "type": "string",
      "format": "date-time",
      "description": "Journal effective date (ISO 8601)."
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Journal memo or notes."
    },
    "CurrencyId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Currency system ID."
    },
    "CurrencyCode": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 4217 currency code (e.g., USD, EUR, AUD)."
    },
    "CurrencySymbol": {
      "type": [
        "string",
        "null"
      ],
      "description": "Currency symbol (e.g., $, €, £)."
    },
    "ExchangeRate": {
      "type": "number",
      "description": "Exchange rate to base currency."
    },
    "JournalType": {
      "type": [
        "string",
        "null"
      ],
      "description": "Type of journal (manual, invoice, purchase, etc.)."
    },
    "VatTreatment": {
      "type": [
        "string",
        "null"
      ],
      "description": "VAT treatment code."
    },
    "ProductType": {
      "type": [
        "string",
        "null"
      ],
      "description": "Product type classification."
    },
    "IncludeInVatReturn": {
      "type": "boolean",
      "description": "Whether to include in VAT return."
    },
    "IsBasAdjustment": {
      "type": "boolean",
      "description": "Whether this is a BAS adjustment entry."
    },
    "LineItemTotal": {
      "type": "number",
      "description": "Sum of line item amounts."
    },
    "Total": {
      "type": "number",
      "description": "Total amount in transaction currency."
    },
    "BcyTotal": {
      "type": "number",
      "description": "Total amount in base currency."
    },
    "PricePrecision": {
      "type": "integer",
      "description": "Number of decimal places for amounts."
    },
    "OriginalCreatedTime": {
      "type": "string",
      "format": "date-time",
      "description": "When the document was created in the source system (ISO 8601)."
    },
    "LastModifiedTime": {
      "type": "string",
      "format": "date-time",
      "description": "When the document was last modified in the source system (ISO 8601)."
    },
    "OriginalStatus": {
      "type": [
        "string",
        "null"
      ],
      "description": "Status of the document in the source system."
    },
    "ApprovedUserName": {
      "type": [
        "string",
        "null"
      ],
      "description": "User who approved the journal for publishing."
    },
    "ApprovedDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "When the journal was approved for publishing (ISO 8601)."
    },
    "LineItems": {
      "type": "array",
      "description": "Journal debit/credit lines.",
      "items": {
        "$ref": "#/$defs/LineItem"
      }
    },
    "Taxes": {
      "type": "array",
      "description": "Tax breakdown. May be empty.",
      "items": {
        "$ref": "#/$defs/Tax"
      }
    },
    "CustomFields": {
      "type": "array",
      "description": "Tenant-defined custom metadata. May be empty.",
      "items": {
        "$ref": "#/$defs/CustomField"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "LineItem": {
      "type": "object",
      "required": [
        "Amount",
        "Tags"
      ],
      "properties": {
        "AccountCode1": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 1 (e.g., Department, Fund). May be anonymized."
        },
        "AccountCodeName1": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 1. May be anonymized."
        },
        "AccountCode2": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 2 (e.g., Cost Center, Program). May be anonymized."
        },
        "AccountCodeName2": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 2. May be anonymized."
        },
        "AccountCode3": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 3 (e.g., Project, Grant). May be anonymized."
        },
        "AccountCodeName3": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 3. May be anonymized."
        },
        "AccountCode4": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 4 (e.g., Location). May be anonymized."
        },
        "AccountCodeName4": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 4. May be anonymized."
        },
        "AccountCode5": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 5. May be anonymized."
        },
        "AccountCodeName5": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 5. May be anonymized."
        },
        "AccountCode6": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 6. May be anonymized."
        },
        "AccountCodeName6": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 6. May be anonymized."
        },
        "AccountCode7": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 7. May be anonymized."
        },
        "AccountCodeName7": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 7. May be anonymized."
        },
        "AccountCode8": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 8. May be anonymized."
        },
        "AccountCodeName8": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 8. May be anonymized."
        },
        "AccountCode9": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 9. May be anonymized."
        },
        "AccountCodeName9": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 9. May be anonymized."
        },
        "AccountCode10": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code 10. May be anonymized."
        },
        "AccountCodeName10": {
          "type": [
            "string",
            "null"
          ],
          "description": "Multi-dimensional account code name 10. May be anonymized."
        },
        "Description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Line description."
        },
        "DebitOrCredit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "debit",
            "credit",
            null
          ],
          "description": "debit or credit."
        },
        "Amount": {
          "type": "number",
          "description": "Absolute amount for this line."
        },
        "CustomerName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Associated customer name. May be anonymized."
        },
        "TaxName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tax component name on the line. May be anonymized."
        },
        "TaxAuthorityName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tax authority name. May be anonymized."
        },
        "AcquisitionVatName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Acquisition VAT name. May be anonymized."
        },
        "ReverseChargeVatName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reverse charge VAT name. May be anonymized."
        },
        "ProjectName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Project name. May be anonymized."
        },
        "Tags": {
          "type": "array",
          "description": "Tracking tags.",
          "items": {
            "$ref": "#/$defs/Tag"
          }
        }
      },
      "additionalProperties": false
    },
    "Tax": {
      "type": "object",
      "required": [
        "TaxAmount"
      ],
      "properties": {
        "TaxName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name of the tax component."
        },
        "TaxAmount": {
          "type": "number",
          "description": "Amount of tax."
        }
      },
      "additionalProperties": false
    },
    "CustomField": {
      "type": "object",
      "properties": {
        "FieldName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Custom field label."
        },
        "FieldValue": {
          "type": [
            "string",
            "null"
          ],
          "description": "Custom field value."
        }
      },
      "additionalProperties": false
    },
    "Tag": {
      "type": "object",
      "properties": {
        "TagName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tag category name."
        },
        "TagValue": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tag value."
        }
      },
      "additionalProperties": false
    }
  }
}
