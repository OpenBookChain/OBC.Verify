<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="Solnet.Rpc" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published v3 schemas are the verifier's source of truth -->
    <EmbeddedResource Include="..\..\standards\v3\**\*.json" LogicalName="standards/v3/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OBC.Verify.Web.Tests" />
  </ItemGroup>

</Project>
