@page "/standards/v1"

<PageTitle>OBC Standard v1</PageTitle>

<div class="container py-5" style="max-width:860px">
    <h1 class="h3 fw-bold mb-2">OBC Standard v1</h1>
    <p class="text-secondary mb-4">
        Initial OBC standard for verifiable journal publishing.
    </p>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="mb-2">
                <span class="badge bg-success me-2">Active</span>
                <span class="fw-bold">obc-v1</span>
                <span class="text-secondary ms-2">· introduced 2025</span>
            </div>
            <p class="mb-0 text-secondary">
                Solana memo with fields (<code>v</code>, <code>h</code>, <code>a</code>) and SHA-256 verification against the off-chain JSON file.
            </p>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer"
           href="https://github.com/SHAliakbari/OBC.Verify/blob/master/standards/v1/README.md">
            Open v1 Specification
        </a>
        <a class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer"
           href="https://github.com/SHAliakbari/OBC.Verify/blob/master/standards/v1/onchain-schema.json">
            On-chain Schema
        </a>
        <a class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer"
           href="https://github.com/SHAliakbari/OBC.Verify/blob/master/standards/v1/offchain-schema.json">
            Off-chain Schema
        </a>
    </div>
</div>
