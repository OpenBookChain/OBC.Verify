@page "/not-found"
@layout MainLayout

<PageTitle>Page not found — OBC Verify</PageTitle>

<div class="container py-5" style="max-width:760px">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <p class="text-uppercase text-secondary small fw-semibold mb-2">404</p>
            <h1 class="h3 fw-bold mb-3">Page not found</h1>
            <p class="text-secondary mb-4">
                The page you requested does not exist or has moved. Use the links below to return to the verifier or the standards reference.
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-primary" href="/">Open verifier</a>
                <a class="btn btn-outline-secondary" href="/standards">View standards</a>
            </div>
        </div>
    </div>
</div>
