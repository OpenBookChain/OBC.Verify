@page "/"
@page "/verify"
@using OBC.Verify.Web.Models
@using OBC.Verify.Web.Services
@inject VerificationService VerificationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>OBC Verify — Solana Record Verifier</PageTitle>

<div class="container py-5" style="max-width:760px">
    <div class="mb-4">
        <h1 class="h3 fw-bold">OBC Record Verifier</h1>
        <p class="text-secondary">
            Enter a Solana transaction ID to independently verify a certified OBC journal record.
            No access to the OBC platform is required — verification is fully on-chain.
        </p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <EditForm Model="_input" OnValidSubmit="RunVerificationAsync" FormName="verify-form">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Solana Transaction ID</label>
                    <InputText @bind-Value="_input.TransactionId"
                               class="@($"form-control font-monospace{(_txError is null ? "" : " is-invalid")}")"
                               placeholder="e.g. 5U1q...Kj7R" />
                    @if (_txError is not null)
                    {
                        <div class="invalid-feedback">@_txError</div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Network</label>
                    <InputSelect @bind-Value="_input.Network" class="form-select">
                        <option value="@SolanaNetwork.MainnetBeta">Mainnet Beta</option>
                        <option value="@SolanaNetwork.Devnet">Devnet</option>
                        <option value="@SolanaNetwork.Testnet">Testnet</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Expected publisher wallet <span class="text-secondary fw-normal">(optional)</span></label>
                    <InputText @bind-Value="_input.ExpectedSigner"
                               class="form-control font-monospace"
                               placeholder="The organisation's Solana wallet, if you know it" />
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Verifying…</span>
                    }
                    else
                    {
                        <span>Verify</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>

    @if (_result is not null)
    {
        <div class="card shadow-sm mb-4 border-@(_result.IsVerified ? "success" : "danger")">
            <div class="card-header @(_result.IsVerified ? "bg-success" : "bg-danger") text-white fw-bold d-flex align-items-center gap-2">
                @if (_result.IsVerified)
                {
                    <span>✅ @VerifiedLabel(_result)</span>
                }
                else
                {
                    <span>❌ Verification Failed</span>
                }
                @if (_shareUrl is not null)
                {
                    <button type="button" class="btn btn-sm btn-light ms-auto" @onclick="CopyShareLinkAsync">
                        @(_linkCopied ? "Link copied" : "Copy link to this result")
                    </button>
                }
            </div>
            <div class="card-body">

                @if (!_result.IsVerified && !string.IsNullOrEmpty(_result.ErrorMessage))
                {
                    <div class="alert alert-danger">@_result.ErrorMessage</div>
                }
                @if (_result.IsVerified && _result.IsVoided)
                {
                    <div class="alert alert-warning">
                        This record is a <strong>tombstone</strong>: the document was voided@(string.IsNullOrEmpty(_result.VoidReason) ? "" : $" ({_result.VoidReason})").
                    </div>
                }
                @if (_result.IsVerified && _result.Chain?.Latest is { } latest)
                {
                    <div class="alert alert-warning">
                        This record is authentic but has been <strong>superseded by version @latest.Number</strong>
                        (@VerificationService.FormatDate(latest.BlockTime))@(_result.Chain.LatestIsVoided == true ? ", which voids the document" : "").
                        <a href="@ExplorerTxUrl(latest.Signature)" target="_blank" rel="noopener noreferrer">View the latest version</a>
                    </div>
                }
                @if (_result.IsVerified && _result.Chain is { IsSuperseded: false, ScanComplete: false })
                {
                    <div class="alert alert-warning">
                        <strong>History incomplete:</strong> the version history was only partly scanned, so a newer version of this document may exist.
                    </div>
                }
                @if (_result.IsVerified && !_result.TypeRecognized)
                {
                    <div class="alert alert-info">
                        Integrity verified, type not recognized: this verifier doesn't know the schema <code>@_result.SchemaId</code>.
                    </div>
                }
                @if (_result.Warnings.Count > 0)
                {
                    <div class="alert alert-warning small">
                        <ul class="mb-0 ps-3">
                            @foreach (var warning in _result.Warnings)
                            {
                                <li class="text-break">@warning</li>
                            }
                        </ul>
                    </div>
                }

                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        @if (!string.IsNullOrEmpty(_result.StandardVersion))
                        {
                            <tr>
                                <th class="text-secondary" style="width:180px">Standard</th>
                                <td>obc-v@(_result.StandardVersion)</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_result.Signer))
                        {
                            <tr>
                                <th class="text-secondary">Signed by</th>
                                <td><a href="@ExplorerAddressUrl(_result.Signer)" target="_blank" rel="noopener noreferrer" class="font-monospace text-break small">@_result.Signer</a></td>
                            </tr>
                        }
                        @if (_result.BlockTime is { } blockTime)
                        {
                            <tr>
                                <th class="text-secondary">Published</th>
                                <td>@VerificationService.FormatDate(blockTime)</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_result.DocumentType))
                        {
                            <tr>
                                <th class="text-secondary">Document type</th>
                                <td>@_result.DocumentType <span class="text-secondary small font-monospace">(@_result.SchemaId)</span></td>
                            </tr>
                        }
                        @if (_result.OnChainMemo?.VersionNumber is { } versionNumber)
                        {
                            <tr>
                                <th class="text-secondary">Document version</th>
                                <td>@versionNumber <span class="text-secondary small font-monospace text-break">(d = @_result.OnChainMemo.DocumentId)</span></td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_result.LocationAccount))
                        {
                            <tr>
                                <th class="text-secondary">Location account</th>
                                <td><a href="@ExplorerAddressUrl(_result.LocationAccount)" target="_blank" rel="noopener noreferrer" class="font-monospace text-break small">@_result.LocationAccount</a></td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_result.Network))
                        {
                            <tr>
                                <th class="text-secondary">Network</th>
                                <td>@_result.Network</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_result.OnChainHash))
                        {
                            <tr>
                                <th class="text-secondary">On-chain Hash</th>
                                <td class="font-monospace text-break small">@_result.OnChainHash</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_result.ComputedHash))
                        {
                            <tr>
                                <th class="text-secondary">Computed Hash</th>
                                <td class="font-monospace text-break small @(string.Equals(_result.ComputedHash, _result.OnChainHash, StringComparison.OrdinalIgnoreCase) ? "text-success" : "text-danger")">
                                    @_result.ComputedHash
                                </td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_result.FileUrl))
                        {
                            <tr>
                                <th class="text-secondary">File URL</th>
                                <td><a href="@_result.FileUrl" target="_blank" class="text-break small">@_result.FileUrl</a></td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(_result.TransactionId))
                        {
                            var explorerUrl = ExplorerTxUrl(_result.TransactionId);
                            <tr>
                                <th class="text-secondary">Explorer</th>
                                <td><a href="@explorerUrl" target="_blank" class="text-break small">@explorerUrl</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Verification Steps</div>
            <ul class="list-group list-group-flush">
                @foreach (var step in _result.Steps)
                {
                    <li class="list-group-item d-flex gap-3 align-items-start py-2">
                        <span class="mt-1">@(step.IsWarning ? "⚠️" : step.Passed ? "✅" : "❌")</span>
                        <div>
                            <div class="fw-semibold">@step.Name</div>
                            @if (!string.IsNullOrEmpty(step.Detail))
                            {
                                <div class="text-secondary small font-monospace text-break">@step.Detail</div>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>

        @if (_result.Chain is { } chain)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold">Version History</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Version</th>
                                <th>Published</th>
                                <th>Hash</th>
                                <th>Transaction</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var version in chain.Versions)
                            {
                                var isCurrent = version.Signature == _result.TransactionId;
                                <tr class="@(isCurrent ? "table-active" : "")">
                                    <td class="ps-3">
                                        @version.Number
                                        @if (isCurrent)
                                        {
                                            <span class="badge bg-secondary ms-1">this record</span>
                                        }
                                        @if (version == chain.Latest && chain.LatestIsVoided == true)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">voided</span>
                                        }
                                    </td>
                                    <td class="small">@VerificationService.FormatDate(version.BlockTime)</td>
                                    <td class="font-monospace small" title="@version.Hash">@version.Hash[..12]…</td>
                                    <td class="small"><a href="@ExplorerTxUrl(version.Signature)" target="_blank" rel="noopener noreferrer" class="font-monospace">@version.Signature[..12]…</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!chain.ScanComplete)
                {
                    <div class="card-footer small text-secondary">History incomplete: only part of the history was scanned, so versions may be missing.</div>
                }
            </div>
        }

        @if (_result.Links.Count > 0)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold">Linked Records</div>
                <ul class="list-group list-group-flush">
                    @foreach (var link in _result.Links)
                    {
                        <li class="list-group-item small">
                            <span class="fw-semibold">@link.Rel</span>
                            @if (!string.IsNullOrEmpty(link.Type))
                            {
                                <span class="text-secondary"> (@link.Type)</span>
                            }
                            <span class="font-monospace text-break ms-1">@link.Hash</span>
                            @if (link.ResolvedUrl is not null)
                            {
                                <a href="@link.ResolvedUrl" target="_blank" rel="noopener noreferrer" class="ms-1">found</a>
                            }
                            else
                            {
                                <span class="text-secondary ms-1">not resolved</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (_result.IsVerified && !string.IsNullOrEmpty(_result.OffChainDocumentJson))
        {
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Off-Chain Document</div>
                <div class="card-body p-0">
                    <pre class="m-0 p-3 small" style="max-height:400px;overflow:auto;background:#f8f9fa">@_result.OffChainDocumentJson</pre>
                </div>
            </div>
        }
    }
</div>

@code {
    private const string InvalidSignatureMessage =
        "This doesn't look like a Solana transaction signature (a base58 string of about 88 characters).";

    private readonly VerifyInput _input = new();
    private VerificationResult? _result;
    private bool _loading;
    private string? _txError;
    private string? _shareUrl;
    private bool _linkCopied;
    private bool _autoRun;

    /// <summary>Deep link: <c>/?tx=&lt;signature&gt;&amp;network=&lt;network&gt;</c> pre-fills the form and verifies once.</summary>
    [SupplyParameterFromQuery(Name = VerifyLink.TxParameter)]
    public string? Tx { get; set; }

    [SupplyParameterFromQuery(Name = VerifyLink.NetworkParameter)]
    public string? NetworkQuery { get; set; }

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Tx)) return;

        _input.TransactionId = Tx.Trim();
        // An unknown network is ignored and the default is used.
        _input.Network = VerifyLink.TryParseNetwork(NetworkQuery, out var network) ? network : VerifyLink.DefaultNetwork;

        if (VerifyLink.IsValidSignature(_input.TransactionId))
        {
            _autoRun = true;
        }
        else
        {
            _txError = InvalidSignatureMessage;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Runs only once the circuit is interactive, never during prerendering.
        if (!firstRender || !_autoRun) return;
        _autoRun = false;

        var verification = RunVerificationAsync();
        StateHasChanged(); // show the spinner while the deep-linked verification runs
        await verification;
        StateHasChanged();
    }

    private async Task RunVerificationAsync()
    {
        if (string.IsNullOrWhiteSpace(_input.TransactionId)) return;
        var transactionId = _input.TransactionId.Trim();
        if (!VerifyLink.IsValidSignature(transactionId))
        {
            _txError = InvalidSignatureMessage;
            return;
        }

        _txError = null;
        _loading = true;
        _result = null;
        _shareUrl = null;
        _linkCopied = false;
        var network = _input.Network;
        try
        {
            _result = await VerificationService.VerifyAsync(
                transactionId,
                network,
                string.IsNullOrWhiteSpace(_input.ExpectedSigner) ? null : _input.ExpectedSigner.Trim());
        }
        finally
        {
            _loading = false;
        }

        // Make the result shareable: only the public signature and the network, never the wallet.
        _shareUrl = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [VerifyLink.TxParameter] = transactionId,
            [VerifyLink.NetworkParameter] = VerifyLink.ToQueryValue(network)
        });
        try
        {
            await JS.InvokeVoidAsync("obcVerify.replaceUrl", _shareUrl);
        }
        catch (JSException)
        {
            // The address bar just isn't updated; the copy link still works.
        }
    }

    private async Task CopyShareLinkAsync()
    {
        if (_shareUrl is null) return;
        try
        {
            await JS.InvokeVoidAsync("obcVerify.copyText", _shareUrl);
            _linkCopied = true;
        }
        catch (JSException)
        {
            // Clipboard access denied; the address bar already holds the link.
        }
    }

    private static string VerifiedLabel(VerificationResult result) =>
        !result.TypeRecognized ? "Integrity verified — type not recognized"
        : result.IsVoided ? "Verified — voided"
        : result.Chain?.Latest is not null ? "Verified — superseded"
        : result.Chain is { ScanComplete: false } ? "Verified — history incomplete"
        : "Verified";

    private string ClusterQuery => _result?.Network switch
    {
        "Devnet"  => "?cluster=devnet",
        "Testnet" => "?cluster=testnet",
        _         => string.Empty
    };

    private string ExplorerTxUrl(string signature) => $"https://explorer.solana.com/tx/{signature}{ClusterQuery}";

    private string ExplorerAddressUrl(string address) => $"https://explorer.solana.com/address/{address}{ClusterQuery}";

    private sealed class VerifyInput
    {
        public string TransactionId { get; set; } = string.Empty;
        public SolanaNetwork Network { get; set; } = VerifyLink.DefaultNetwork;
        public string? ExpectedSigner { get; set; }
    }
}
