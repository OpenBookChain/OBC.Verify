@page "/standards/v2"

<PageTitle>OBC Standard v2</PageTitle>

<div class="container py-5" style="max-width:860px">
    <h1 class="h3 fw-bold mb-2">OBC Standard v2</h1>
    <p class="text-secondary mb-4">
        OBC v2 extends the model with multi-dimensional accounting fields.
    </p>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="mb-2">
                <span class="badge bg-success me-2">Active</span>
                <span class="fw-bold">obc-v2</span>
                <span class="text-secondary ms-2">· introduced 2026</span>
            </div>
            <p class="mb-0 text-secondary">
                Adds <code>accountCode1..10</code> and <code>accountCodeName1..10</code> for line-item dimensional accounting while preserving the same hash verification flow.
            </p>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer"
           href="https://github.com/SHAliakbari/OBC.Verify/blob/master/standards/v2/README.md">
            Open v2 Specification
        </a>
        <a class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer"
           href="https://github.com/SHAliakbari/OBC.Verify/blob/master/standards/v2/onchain-schema.json">
            On-chain Schema
        </a>
        <a class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer"
           href="https://github.com/SHAliakbari/OBC.Verify/blob/master/standards/v2/offchain-schema.json">
            Off-chain Schema
        </a>
    </div>
</div>
