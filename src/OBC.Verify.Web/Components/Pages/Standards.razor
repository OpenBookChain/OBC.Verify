@page "/standards"

<PageTitle>Standards — OBC</PageTitle>

<div class="container py-5" style="max-width:760px">
    <h1 class="h3 fw-bold mb-2">OBC Standards</h1>
    <p class="text-secondary mb-4">
        Each version of the OBC publishing format is documented as an immutable standard.
        Older standards remain verifiable indefinitely.
    </p>

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-success me-2">Active</span>
                <span class="fw-bold">obc-v1</span>
                <span class="text-secondary ms-2">· introduced 2025</span>
                <p class="mb-0 mt-1 text-secondary small">
                    Solana memo (v, h, a) + SHA-256 hash + Azure Blob Storage JSON.
                </p>
            </div>
            <a href="/standards/v1" class="btn btn-sm btn-outline-primary">View</a>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-success me-2">Active</span>
                <span class="fw-bold">obc-v2</span>
                <span class="text-secondary ms-2">· introduced 2026</span>
                <p class="mb-0 mt-1 text-secondary small">
                    Multi-dimensional accounting with accountCode1..10 and accountCodeName1..10.
                </p>
            </div>
            <a href="/standards/v2" class="btn btn-sm btn-outline-primary">View</a>
        </div>
    </div>
</div>
